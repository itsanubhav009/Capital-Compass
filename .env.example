# ---- Core ----
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any other hostname the site answers on — a custom domain, or a Vercel alias
# you actually type. Comma-separated, each with its scheme. A missing hostname
# makes every admin save fail with "You are not allowed to perform this
# action", because Payload only trusts cookie auth from an allowed origin.
# On Vercel, NEXT_PUBLIC_SITE_URL and VERCEL_PROJECT_PRODUCTION_URL are
# already covered; this is for anything else.
ADDITIONAL_ORIGINS=

# Gates /api/preview, which opens unpublished drafts on the live site.
# Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PREVIEW_SECRET=

# ---- Newsletter (Beehiiv) ----
# Settings -> API in the Beehiiv dashboard.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ---- Media storage (optional but recommended for Cloudways/VPS) ----
S3_BUCKET=capital-compass-media
S3_REGION=auto
S3_ENDPOINT=https://7c4eb5f17a0e0fb965e98b04e02dd5b0.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# ---- Analytics (leave blank to disable analytics and the consent banner) ----
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# ---- Email (Gmail over SMTP) ----
# SMTP_USER is the full Gmail address. SMTP_PASS is a 16-character app
# password from myaccount.google.com/apppasswords, NOT the account password
# — creating one requires 2-Step Verification to be on. Spaces in it are
# stripped automatically, so paste it however Google shows it.
#
# EMAIL_FROM should match SMTP_USER: Gmail rewrites the From header to the
# authenticated account unless the address is a verified alias.
#
# Limit is roughly 500 recipients a day on a free account, 2,000 on Workspace.
# Test with: npm run email:test you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
