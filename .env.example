# ─────────────────────────────────────────────────────────────
# REQUIRED — the app will not boot without these three
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
#   Neon (free, no install):  https://neon.tech -> create project -> copy string
#   Local docker:             postgres://postgres:postgres@localhost:5432/capital_compass
DATABASE_URI=postgres://postgres:postgres@localhost:5432/capital_compass

# Signs login cookies and password hashes. Any long random string.
# Generate:  openssl rand -base64 32
# Changing this later logs everyone out. Never commit the real value.
PAYLOAD_SECRET=

# Public origin. Used for canonical URLs, sitemap.xml, robots.txt and OG tags.
# Local:       http://localhost:3000
# Codespaces:  https://<your-codespace>-3000.app.github.dev
# Production:  https://capitalcompass.com   <- must be the real domain at launch
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─────────────────────────────────────────────────────────────
# NEWSLETTER — leave blank for now; signup returns a clean
# "not connected yet" message until both are filled in
# ─────────────────────────────────────────────────────────────

# Beehiiv dashboard -> Settings -> Integrations -> API
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=


# ─────────────────────────────────────────────────────────────
# MEDIA STORAGE — optional locally, REQUIRED in production on
# any host with an ephemeral disk (Vercel, most containers).
# Without it, uploaded images vanish on every deploy.
# Works with AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces.
# ─────────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
